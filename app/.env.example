# vLLM Configuration
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_MODEL=/models/Qwen2.5-0.5B-Instruct
VLLM_API_KEY=my-super-secret-rag-key-2026

# Qdrant Vector DB Configuration (StatefulSet Service in K8s)
QDRANT_HOST=qdrant-service
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# AWS S3 Raw Uploads Storage
S3_BUCKET=vllmm
S3_UPLOAD_PREFIX=uploads

# PostgreSQL (AWS RDS)
DATABASE_URL=postgresql://ragadmin:CHANGE_PASSWORD@rag-postgres-db.czgcwg4ygg4l.eu-north-1.rds.amazonaws.com:5432/ragdb?sslmode=require

# RAG Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=115
TOP_K=4
MAX_FILE_SIZE_MB=10
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
