# vLLM Configuration
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_MODEL=/models/Qwen2.5-0.5B-Instruct
VLLM_API_KEY=change-me-in-aws-secrets-manager

# Qdrant Vector DB Configuration (StatefulSet Service in K8s)
QDRANT_HOST=qdrant-service
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# PostgreSQL (AWS RDS)
DATABASE_URL=postgresql://ragadmin:CHANGE_PASSWORD@YOUR_RDS_ENDPOINT:5432/ragdb

# RAG Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=115
TOP_K=4
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
